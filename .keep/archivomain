import os
from fastapi import FastAPI, HTTPException
from fastapi.middleware.cors import CORSMiddleware
from pydantic import BaseModel
from openai import OpenAI
from dotenv import load_dotenv

# Carga variables de entorno desde un archivo .env si existe
load_dotenv()

app = FastAPI(title="PromptFlow AI API")

# Configuración de CORS para permitir la conexión desde el frontend de React
app.add_middleware(
    CORSMiddleware,
    allow_origins=["*"],  # En producción, cambia esto por la URL de tu frontend
    allow_credentials=True,
    allow_methods=["*"],
    allow_headers=["*"],
)

# Inicializa el cliente de OpenAI (Busca la variable de entorno OPENAI_API_KEY)
client = OpenAI(api_key=os.environ.get("OPENAI_API_KEY"))

class PromptRequest(BaseModel):
    idea: str
    estilo: str
    movimiento: str

@app.post("/api/generate-prompt")
async def generate_video_prompt(request: PromptRequest):
    if not request.idea.strip():
        raise HTTPException(status_code=400, detail="La idea no puede estar vacía.")
        
    system_instruction = (
        "You are an expert Prompt Engineer for AI video generators like Kling AI, Runway Gen-3, Luma Dream Machine, and Sora. "
        "Your task is to transform a simple user idea into a highly descriptive, visual prompt in ENGLISH. "
        "Structure the prompt strictly in this order: [Main Subject & Action], [Visual Style & Aesthetics], [Camera Shot & Cinematic Movement], [Lighting & Atmosphere], [High-Quality Render Keywords]. "
        "Output ONLY the final English prompt string. Do not include introductory text, quotes, or explanations."
    )
    
    user_prompt = f"Transform this idea: '{request.idea}'. Style requirement: '{request.estilo}'. Camera movement requirement: '{request.movimiento}'."
    
    try:
        response = client.chat.completions.create(
            model="gpt-4o-mini",  # Rápido, inteligente y sumamente económico
            messages=[
                {"role": "system", "content": system_instruction},
                {"role": "user", "content": user_prompt}
            ],
            temperature=0.7
        )
        return {"success": True, "prompt": response.choices.message.content.strip()}
    except Exception as e:
        raise HTTPException(status_code=500, detail=str(e))

if __name__ == "__main__":
    import uvicorn
    uvicorn.run("main:app", host="0.0.0.0", port=8000, reload=True)
